<Window x:Class="IFAS.VMS.Client.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF" Title="IFAS VMS" Width="1500" Height="900" Background="#101418">
<Grid>
<Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<StackPanel Grid.Column="0" Background="#182028">
<TextBlock Text="IFAS VMS" FontSize="28" FontWeight="Bold" Foreground="White" Margin="18"/>
<Button Content="Dashboard" Click="Dashboard_Click"/><Button Content="Live View" Click="Live_Click"/><Button Content="Playback" Click="Playback_Click"/>
<Button Content="Camera Management" Click="Camera_Click"/><Button Content="NVR Management" Click="Nvr_Click"/>
<Button Content="Recording / Storage" Click="Storage_Click"/><Button Content="Events &amp; Alerts"/><Button Content="System Logs"/><Button Content="Settings"/>
<Separator/>
<StackPanel Orientation="Horizontal"><Button Content="1" Click="G1"/><Button Content="4" Click="G4"/><Button Content="8" Click="G8"/><Button Content="16" Click="G16"/></StackPanel>
<StackPanel Orientation="Horizontal"><Button Content="32" Click="G32"/><Button Content="64" Click="G64"/></StackPanel>
<Button Content="New Monitor Window" Click="Monitor_Click"/>
</StackPanel>
<Grid Grid.Column="1" Margin="10">
<Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="210"/></Grid.RowDefinitions>
<TextBlock x:Name="TitleText" Text="Dashboard" FontSize="24" Foreground="White" Margin="5"/>
<Grid x:Name="LiveGrid" Grid.Row="1" AllowDrop="True" Background="#07090B" Drop="LiveGrid_Drop"/>
<DataGrid x:Name="DeviceGrid" Grid.Row="2" AutoGenerateColumns="True" Margin="0,8" SelectionMode="Single"/>
</Grid></Grid></Window>
